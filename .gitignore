# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Ignore all files inside ChromaDB directories
database/semantic_cache/**
database/vector_db/**

# Keep the directories themselves
!database/
!database/semantic_cache/
!database/vector_db/

# Keep an empty placeholder file so Git tracks the folders
!database/semantic_cache/.gitkeep
!database/vector_db/.gitkeep
